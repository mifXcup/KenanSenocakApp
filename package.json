{
  "name": "kenan-senocak-yonetim",
  "version": "0.5.10",
  "private": true,
  "author": "Kenan Şenocak",
  "description": "Kenan Şenocak Yönetim masaüstü uygulaması",
  "repository": {
    "type": "git",
    "url": "https://github.com/mifXcup/KenanSenocakApp.git"
  },
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n UI,DESKTOP -c cyan,green \"npm --prefix frontend run dev -- --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && set VITE_DEV_SERVER_URL=http://127.0.0.1:5173&& electron .\"",
    "build:icon": "node scripts/build-icon.mjs",
    "build:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
    "build:ui": "npm --prefix frontend run build",
    "configure:update": "node scripts/configure-update.mjs",
    "build": "npm run build:icon && npm run build:backend && npm run build:ui && electron-builder --dir",
    "dist": "npm run build:icon && npm run build:backend && npm run build:ui && electron-builder --win nsis --publish never",
    "dist:publish": "npm run build:icon && npm run build:backend && npm run build:ui && electron-builder --win nsis --publish always",
    "test": "npm --prefix frontend run test && node --test desktop/main.test.cjs",
    "lint": "npm --prefix frontend run lint"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "tr.kenansenocak.yonetim",
    "productName": "Kenan Şenocak Yönetim",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/**/*",
      "frontend/dist/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist/ks-core",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kenan Şenocak Yönetim"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  }
}
